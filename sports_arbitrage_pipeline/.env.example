# Copy to harvester/.env (orchestrator reads harvester/.env, not this file)
#   cp .env.example ../harvester/.env
#
# Get a key: https://the-odds-api.com/

ODDS_API_KEY=your_key_here
# Alias accepted by harvester settings:
# THE_ODDS_API_KEY=your_key_here

ODDS_API_REGIONS=us
ODDS_API_MARKETS=h2h,spreads,totals
HARVESTER_DEFAULT_SPORT=basketball_nba

# Optional local LLM (normalization) — see ../local-llm/
# HARVESTER_USE_LOCAL_NORMALIZATION=0
