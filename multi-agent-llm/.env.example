# Ollama API (default local install)
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Model A = writes code (7B coder — slow on CPU, OK if you have patience)
MULTI_AGENT_MODEL_A=qwen2.5-coder:7b-instruct-q4_K_M

# Model B = reviews (use 3B on 16GB RAM — do NOT use 14b unless you have pulled it and enough RAM)
MULTI_AGENT_MODEL_B=qwen2.5:3b-instruct-q4_K_M

MULTI_AGENT_MAX_LOOPS=3
MULTI_AGENT_TASK=Write a Python function to validate email addresses
