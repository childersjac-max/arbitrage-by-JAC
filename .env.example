# Frontend: leave empty for same-origin /api on Vercel
VITE_API_BASE_URL=

# Optic Odds API key (required for live odds + arbitrage scanner)
ODDSJAM_API_KEY=

# The Odds API — used by nc_arb_collector for DK / FD / BetMGM (NC books)
ODDS_API_KEY=

# NC arb collector tuning (optional)
# NC_ARB_SPORT_KEYS=americanfootball_nfl,basketball_nba
# NC_ARB_MIN_YIELD_PCT=0.5
# NC_ARB_POLL_SEC=45

# Optional: Neon Postgres (future persistent alerts; app uses in-memory alerts today)
DATABASE_URL=

# Optional push notifications for alerts
NTFY_TOPIC=

SESSION_SECRET=
