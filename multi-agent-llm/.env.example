# Ollama API
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# --- Project context (always sports arbitrage) ---
PROJECT_NAME=arbitrage-by-JAC sports arbitrage
PROJECT_ROOT=C:/Users/child/Projects/arbitrage-by-JAC
PROJECT_ROOT_BASH=~/Projects/arbitrage-by-JAC
PROJECT_ROOT_WIN=C:\Users\child\Projects\arbitrage-by-JAC
INJECT_PROJECT_CONTEXT=1
INJECT_FILE_MAP=1

# App URLs (used in prompts — set LAN IP for phone access)
LOCAL_LLM_UI_PORT=7860
HARVESTER_UI_PORT=8765
LAN_IP=192.168.1.100
APP_URL_LOCAL_LLM=http://127.0.0.1:7860
APP_URL_LOCAL_LLM_LAN=http://192.168.1.100:7860
APP_URL_HARVESTER=http://127.0.0.1:8765
APP_URL_PUBLIC=

# --- 3-agent models (16GB RAM / CPU) ---
MODEL_PLANNER=qwen2.5:3b-instruct-q4_K_M
MODEL_CODER=qwen2.5-coder:7b-instruct-q4_K_M
MODEL_REVIEWER=qwen2.5:3b-instruct-q4_K_M

MAX_LOOPS=3
DELAY_BETWEEN_CALLS=2
MIN_SCORE_REGENERATE=6
STREAM_OUTPUT=1

TIMEOUT_PLANNER_SEC=120
TIMEOUT_CODER_SEC=600
TIMEOUT_REVIEWER_SEC=180

MULTI_AGENT_TASK=Write a Python function to validate email addresses

# System prompts: edit prompts/*.txt (not pipeline_core.py)

# AutoGen
AUTOGEN_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_HOST=http://127.0.0.1:11434
AUTOGEN_RUN_CODE=0
