# The Odds API — https://the-odds-api.com/
ODDS_API_KEY=your_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com
ODDS_API_REGIONS=us
ODDS_API_MARKETS=h2h
ODDS_API_ODDS_FORMAT=decimal

# Pipeline defaults
HARVESTER_DEFAULT_SPORT=basketball_nba
HARVESTER_HTTP_TIMEOUT_SEC=30
HARVESTER_MIN_ARB_YIELD_PCT=0.1
HARVESTER_DASHBOARD_FAST_MODE=true
HARVESTER_USE_LOCAL_NORMALIZATION=false
HARVESTER_USE_LLM_ARBITRAGE=false
HARVESTER_LLM_ARB_MAX_EVENTS=25
HARVESTER_LLM_ARB_MAX_TOKENS=4096
HARVESTER_RUN_TIMEOUT_SEC=600

# Dashboard (Live Arbitrage Finder)
HARVESTER_UI_HOST=127.0.0.1
HARVESTER_UI_PORT=8765

# local-llm uses local-llm/.env (OLLAMA_HOST, OLLAMA_MODEL, etc.)
