# Frontend: leave empty for same-origin /api on Vercel
VITE_API_BASE_URL=

# Optic Odds API key (required for live odds + arbitrage scanner)
ODDSJAM_API_KEY=
THE_ODDS_API_KEY=

# Harvester pipeline
HARVESTER_SPORTS=basketball_nba,americanfootball_nfl
HARVESTER_MARKETS=h2h,spreads,totals
HARVESTER_REGIONS=us
HARVESTER_POLL_INTERVAL_SECONDS=30
HARVESTER_ADAPTER_TIMEOUT_SECONDS=15
HARVESTER_RETRY_ATTEMPTS=3
HARVESTER_NORMALIZE_CACHE_PATH=.cache/harvester/normalize_cache.sqlite3
HARVESTER_REFERENCE_PATH=
HARVESTER_OUTPUT_PATH=
HARVESTER_PRETTY_JSON=true
HARVESTER_ENABLE_POLYMARKET=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LOCAL_LLM_TIMEOUT_SECONDS=20
LOCAL_LLM_BATCH_SIZE=32

# Optional: Neon Postgres (future persistent alerts; app uses in-memory alerts today)
DATABASE_URL=

# Optional push notifications for alerts
NTFY_TOPIC=

SESSION_SECRET=
