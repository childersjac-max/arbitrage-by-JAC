# Required: your paid The Odds API key (https://the-odds-api.com)
ODDS_API_KEY=

# Optional: comma-separated sport keys (defaults in config.py)
ARB_SPORT_KEYS=basketball_nba,americanfootball_nfl,icehockey_nhl

# Polling interval seconds for the live orchestrator
ARB_POLL_INTERVAL_SEC=45

# Minimum arbitrage yield (%) to emit in unified payload
ARB_MIN_YIELD_PCT=0.25

# HTTP politeness (requests per second per host, global cap)
ARB_HTTP_RPS=2.0

# Regions for The Odds API (includes UK/EU exchanges when on your plan)
ARB_ODDS_API_REGIONS=us,us2,uk,eu

# Supplemental toggles
ARB_ENABLE_KALSHI=1
ARB_ENABLE_POLYMARKET=1
ARB_ENABLE_SX_BET=1
ARB_ENABLE_BETFAIR=0

# Betfair Exchange official API (optional)
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
