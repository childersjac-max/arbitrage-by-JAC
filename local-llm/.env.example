# Backend: ollama | vllm | openai_compat
LOCAL_LLM_BACKEND=ollama

# Ollama (default http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_MODEL_FAST=qwen2.5:1.5b-instruct-q4_K_M

# vLLM / OpenAI-compatible (default http://127.0.0.1:8000/v1)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Inference tuning (speed-first, deterministic)
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_MAX_TOKENS=512
LOCAL_LLM_TIMEOUT_SEC=45
LOCAL_LLM_PROMPT_TIMEOUT_SEC=600
LOCAL_LLM_MAX_RETRIES=3

# Client concurrency
LOCAL_LLM_MAX_CONNECTIONS=32
LOCAL_LLM_BATCH_CONCURRENCY=8

# Free-form prompting (prompt_cli.py, prompt_server.py)
LOCAL_LLM_PROMPT_MAX_TOKENS=4096
LOCAL_LLM_PROMPT_TEMPERATURE=0.2

# Chat modes (web_app.py — Fast vs Normal radio)
LOCAL_LLM_DEFAULT_CHAT_MODE=fast
LOCAL_LLM_FAST_MAX_TOKENS=256
LOCAL_LLM_FAST_MAX_TOKENS_CAP=512
LOCAL_LLM_FAST_NUM_CTX=1024
LOCAL_LLM_FAST_MAX_HISTORY=2
LOCAL_LLM_FAST_TIMEOUT_SEC=600
LOCAL_LLM_FAST_SYSTEM_PROMPT_FILE=prompts/system_fast.txt
LOCAL_LLM_NORMAL_MAX_TOKENS=512
LOCAL_LLM_NORMAL_MAX_TOKENS_CAP=2048
LOCAL_LLM_NORMAL_NUM_CTX=2048
LOCAL_LLM_NORMAL_MAX_HISTORY=4
LOCAL_LLM_NORMAL_TIMEOUT_SEC=900
LOCAL_LLM_NORMAL_SYSTEM_PROMPT_FILE=prompts/system_default.txt

# System prompt: edit prompts/system_default.txt (recommended).
# Optional override file path (relative to local-llm/):
# LOCAL_LLM_SYSTEM_PROMPT_FILE=prompts/system_default.txt
# Optional one-line override (instead of file):
# LOCAL_LLM_DEFAULT_SYSTEM=You are a helpful assistant.
LOCAL_LLM_PROMPT_SERVER_HOST=127.0.0.1
LOCAL_LLM_PROMPT_SERVER_PORT=5050

# Web app (web_app.py)
LOCAL_LLM_UI_HOST=127.0.0.1
LOCAL_LLM_UI_PORT=7860
LOCAL_LLM_UI_MAX_TOKENS=512
LOCAL_LLM_UI_TIMEOUT_SEC=900

# 8B model tuning (Ollama)
OLLAMA_NUM_CTX=8192
OLLAMA_CHAT_NUM_CTX=4096
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1

# Phased architect (large prompts)
ARCHITECT_MAX_PHASES=5
ARCHITECT_PLAN_MAX_TOKENS=1024
ARCHITECT_PHASE_MAX_TOKENS=2048
ARCHITECT_TEMPERATURE=0.15
