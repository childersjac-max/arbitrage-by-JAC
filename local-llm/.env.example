# =============================================================================
# LOCAL LLM — CPU-OPTIMIZED (Windows + Ollama)
# =============================================================================
# ONE-LINE PROFILE SWITCH (recommended):
#   LOCAL_LLM_PERFORMANCE_PROFILE=balanced
# Or run:  python scripts/set_profile.py fast|balanced|quality
#
# Pull models once:
#   ollama pull qwen2.5:1.5b-instruct-q4_K_M
#   ollama pull qwen2.5:3b-instruct-q4_K_M
#   ollama pull qwen2.5-coder:7b-instruct-q4_K_M
# =============================================================================

LOCAL_LLM_BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434

# --- Profile model mapping ---
OLLAMA_MODEL_FAST=qwen2.5:1.5b-instruct-q4_K_M
OLLAMA_MODEL_BALANCED=qwen2.5:3b-instruct-q4_K_M
OLLAMA_MODEL_QUALITY=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

LOCAL_LLM_PERFORMANCE_PROFILE=balanced
# Remap saved UI "Quality" to Balanced on load (7B chat times out on CPU)
LOCAL_LLM_PREFER_BALANCED_CHAT=1

# --- CPU tuning (all profiles) ---
LOCAL_LLM_BATCH_CONCURRENCY=1
OLLAMA_NUM_CTX=2048
OLLAMA_CHAT_NUM_CTX=1536
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
# Set to physical core count (e.g. 8); unset = Ollama default
# OLLAMA_NUM_THREAD=8

# --- FAST profile ---
PROFILE_FAST_MAX_TOKENS=192
PROFILE_FAST_MAX_TOKENS_CAP=384
PROFILE_FAST_NUM_CTX=768
PROFILE_FAST_MAX_HISTORY=1
PROFILE_FAST_TIMEOUT_SEC=300
PROFILE_FAST_TEMPERATURE=0.2
PROFILE_FAST_SYSTEM_PROMPT_FILE=prompts/system_fast.txt

# --- BALANCED profile (default) ---
PROFILE_BALANCED_MAX_TOKENS=384
PROFILE_BALANCED_MAX_TOKENS_CAP=768
PROFILE_BALANCED_NUM_CTX=1536
PROFILE_BALANCED_MAX_HISTORY=2
PROFILE_BALANCED_TIMEOUT_SEC=480
PROFILE_BALANCED_TEMPERATURE=0.2
PROFILE_BALANCED_SYSTEM_PROMPT_FILE=prompts/system_balanced.txt

# --- QUALITY profile ---
PROFILE_QUALITY_MAX_TOKENS=512
PROFILE_QUALITY_MAX_TOKENS_CAP=1024
PROFILE_QUALITY_NUM_CTX=2048
PROFILE_QUALITY_MAX_HISTORY=3
PROFILE_QUALITY_TIMEOUT_SEC=900
PROFILE_QUALITY_TEMPERATURE=0.2
PROFILE_QUALITY_SYSTEM_PROMPT_FILE=prompts/system_default.txt

# --- Normalization (serialized via workload lock; do not run during chat) ---
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_MAX_TOKENS=320
LOCAL_LLM_TIMEOUT_SEC=60
LOCAL_LLM_MAX_RETRIES=2
LOCAL_LLM_PROMPT_TIMEOUT_SEC=600
LOCAL_LLM_PROMPT_MAX_TOKENS=4096
LOCAL_LLM_PROMPT_TEMPERATURE=0.2

# --- Web UI (your main app URL) ---
LOCAL_LLM_UI_HOST=127.0.0.1
LOCAL_LLM_UI_PORT=7860
# Phone on same Wi-Fi: bind 0.0.0.0 and print http://192.168.x.x:7860
LOCAL_LLM_UI_LAN=0
# Public tunnel (optional): Gradio prints https://....gradio.live at startup
LOCAL_LLM_UI_SHARE=0
LOCAL_LLM_UI_SHARE_INSECURE=0

# --- Sports arbitrage project context (injected into every chat) ---
PROJECT_ROOT=C:/Users/child/Projects/arbitrage-by-JAC
APP_URL_HARVESTER=http://127.0.0.1:8765
INJECT_PROJECT_CONTEXT_IN_CHAT=1

# --- Architect (Balanced/Quality only) ---
ARCHITECT_MAX_PHASES=5
ARCHITECT_PLAN_MAX_TOKENS=1024
ARCHITECT_PHASE_MAX_TOKENS=2048
ARCHITECT_TEMPERATURE=0.15

# --- Optional vLLM (GPU server) ---
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
